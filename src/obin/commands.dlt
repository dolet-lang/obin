##############################
# Obin command orchestration.
##############################

struct ObinOptions:
    manifest: str = ""
    profile: str = ""
    target: str = ""
    output: str = ""
    compiler: str = ""
    app_arguments: str = ""
    force: i32 = 0
    no_dependencies: i32 = 0
    no_tools: i32 = 0
    verbose: i32 = 0

g_obin_last_output: str = ""
g_obin_last_target_alias: str = ""
g_obin_last_target_os: str = ""

fun obin_fail(message: str):
    print(@"obin: {message}")
    Process.exit(1)

fun obin_version() -> str:
    return "0.3.0"

fun obin_print_version():
    print(Str.concat("obin ", obin_version()))

fun obin_print_help():
    print("Obin - application tooling for the Dolet language")
    print("")
    print("Usage:")
    print("  obin init [directory]")
    print("  obin build [manifest] [options]")
    print("  obin run [manifest] [options] [-- application arguments]")
    print("  obin package [manifest] [options]")
    print("  obin clean [manifest]")
    print("  obin doctor [manifest]")
    print("")
    print("Build options:")
    print("  --profile <name>    Select a manifest profile")
    print("  --target <name>     Select a [targets.<name>] alias or canonical target")
    print("  --out, -o <path>    Override the executable path")
    print("  --compiler <path>   Override doletc")
    print("  --force             Rebuild and recook assets")
    print("  --no-deps           Skip DOPM dependency sync")
    print("  --no-tools          Skip tool adapters and hooks")
    print("  --verbose           Print invoked commands")

fun obin_parse_options(start: i32, allow_app_arguments: i32) -> ObinOptions:
    options: ObinOptions = ObinOptions()
    index: i32 = start
    application_mode: i32 = 0
    while index < Argv.count():
        argument: str = Argv.get(index)
        if application_mode == 1:
            options.app_arguments = Str.concat(options.app_arguments, Str.concat(" ", obin_quote(argument)))
        elif Str.equals(argument, "--"):
            if allow_app_arguments == 0:
                obin_fail("unexpected --")
            application_mode = 1
        elif Str.equals(argument, "--profile"):
            index = index + 1
            if index >= Argv.count():
                obin_fail("--profile requires a name")
            options.profile = Argv.get(index)
        elif Str.equals(argument, "--target"):
            index = index + 1
            if index >= Argv.count():
                obin_fail("--target requires a name")
            options.target = Argv.get(index)
        elif Str.equals(argument, "--out") or Str.equals(argument, "-o"):
            index = index + 1
            if index >= Argv.count():
                obin_fail("--out requires a path")
            options.output = Argv.get(index)
        elif Str.equals(argument, "--compiler"):
            index = index + 1
            if index >= Argv.count():
                obin_fail("--compiler requires a path")
            options.compiler = Argv.get(index)
        elif Str.equals(argument, "--force"):
            options.force = 1
        elif Str.equals(argument, "--no-deps"):
            options.no_dependencies = 1
        elif Str.equals(argument, "--no-tools"):
            options.no_tools = 1
        elif Str.equals(argument, "--verbose") or Str.equals(argument, "-v"):
            options.verbose = 1
        elif Str.starts_with(argument, "-"):
            obin_fail(@"unknown option: {argument}")
        elif Memory.strlen(options.manifest) == 0:
            options.manifest = argument
        else:
            obin_fail(@"unexpected argument: {argument}")
        index = index + 1
    return options

fun obin_require_project(hint: str) -> ObinProject:
    project: ObinProject = obin_load_project(hint)
    if project.valid == 0:
        obin_fail(project.error)
    return project

fun obin_read_text(path: str) -> str:
    file: File = File.open_cwd(path, "r")
    if file.is_valid() == false:
        return ""
    result: str = file.read_text()
    file.close()
    return result

fun obin_dependency_signature(document: ObinToml) -> str:
    dependencies: list<str> = obin_toml_section_keys(document, "dependencies")
    signature: str = ""
    index: i64 = 0
    while index < dependencies.size():
        name: str = dependencies.get_str(index)
        key: str = Str.concat("dependencies.", name)
        signature = Str.concat(signature, Str.concat(name, Str.concat("=", Str.concat(obin_toml_get_raw(document, key, "*"), "\n"))))
        index = index + 1
    return signature

fun obin_sync_dependencies(project: ObinProject, document: ObinToml, force: i32) -> i32:
    dependencies: list<str> = obin_toml_section_keys(document, "dependencies")
    if dependencies.size() == 0 or project.auto_sync == 0:
        return 0
    signature: str = obin_dependency_signature(document)
    state: str = obin_resolve_from(PathOps.join_path(project.root, ".obin"), "dependencies.state")
    # Do not trust the signature cache by itself. Packages can be deleted,
    # replaced, or edited while the manifest remains unchanged. DOPM's fast
    # installed-package path verifies both the locked commit and a clean Git
    # tree, preserving reproducible builds without fetching again.
    configured_dopm: str = project.dopm
    if Memory.strlen(configured_dopm) > 0:
        project_dopm: str = obin_resolve_from(project.root, configured_dopm)
        if PathOps.exists(project_dopm) == 1:
            configured_dopm = project_dopm
    dopm: str = obin_find_dopm(configured_dopm)
    if Memory.strlen(dopm) == 0:
        print("obin: dependencies are declared but DOPM was not found")
        print("      set tools.dopm or OBIN_DOPM, or build with --no-deps")
        return 1
    print("[obin] syncing dependencies with DOPM")
    index: i64 = 0
    while index < dependencies.size():
        name: str = dependencies.get_str(index)
        command: str = Str.concat(obin_quote(dopm), Str.concat(" install ", obin_quote(name)))
        requested: str = Str.trim(obin_toml_get_raw(document, Str.concat("dependencies.", name), "*"))
        if Memory.strlen(requested) > 0 and Str.equals(requested, "*") == false:
            # Preserve exact manifest intent. DOPM accepts a source path/URL
            # or a Git revision and writes the resolved commit to dopm.lock.
            if Str.starts_with(requested, "\"") and Str.ends_with(requested, "\""):
                requested = Str.substring(requested, 1, Memory.strlen(requested) - 1)
            command = Str.concat(command, Str.concat(" ", obin_quote(requested)))
        if obin_run_in_directory(command, project.root) != 0:
            print(@"obin: DOPM failed while installing {name}")
            return 1
        index = index + 1
    if obin_write_text(state, signature) == 0:
        print("obin: warning: could not write dependency state")
    return 0

fun obin_run_hooks(project: ObinProject, document: ObinToml, name: str, verbose: i32) -> i32:
    key: str = Str.concat("hooks.", name)
    hooks: list<str> = obin_toml_array(document, key)
    index: i64 = 0
    while index < hooks.size():
        command: str = hooks.get_str(index)
        print(@"[obin] hook {name}")
        if verbose == 1:
            print(@"       {command}")
        code: i32 = obin_run_in_directory(command, project.root)
        if code != 0:
            print(@"obin: hook {name} failed with exit code {code}")
            return code
        index = index + 1
    return 0

# Directories obin writes into. Skipped when scanning for sources so the walk
# never compares the build against itself.
fun obin_is_output_directory(project: ObinProject, name: str) -> i32:
    lower: str = Str.to_lower(name)
    if Str.equals(lower, "build"):
        return 1
    if Memory.strlen(project.package_directory) > 0:
        if Str.equals(lower, Str.to_lower(project.package_directory)):
            return 1
    return 0

# Every .dlt in the project, not only the ones beside the entry point. A helper
# at the project root or a module in lib/ is just as much a source.
fun obin_project_sources_newer(project: ObinProject, stamp: i64) -> i32:
    names: list<str> = Dir.list(project.root)
    index: i64 = 0
    while index < names.size():
        name: str = names.get_str(index)
        path: str = PathOps.join_path(project.root, name)
        if obin_is_directory(path) == 1:
            if obin_skip_directory(name) == 0 and obin_is_output_directory(project, name) == 0:
                if obin_tree_newer(path, stamp, 1) == 1:
                    return 1
        else:
            if Str.ends_with(Str.to_lower(name), ".dlt"):
                if obin_file_stamp(path) > stamp:
                    return 1
        index = index + 1
    return 0

# Packages compile from source on every build, so editing one changes the
# executable even though nothing in the project did. Two roots can supply them:
# the project-local .dopm tree, and the toolchain's own packages and library
# beside doletc. Neither was stamped, which is why editing an engine package
# left obin: could not find obin.toml or dolet.toml launching a stale binary until someone ran a clean by hand.
fun obin_dependency_sources_newer(project: ObinProject, doletc: str, stamp: i64) -> i32:
    local_packages: str = obin_resolve_from(PathOps.join_path(project.root, ".dopm"), "packages")
    if obin_tree_newer(local_packages, stamp, 0) == 1:
        return 1
    # get_directory keeps the trailing separator, so calling it twice returns the
    # same folder rather than climbing. Step up explicitly instead â€” doletc itself
    # addresses its own tree the same way (bin/../library).
    toolchain: str = PathOps.join_path(PathOps.get_directory(doletc), "..")
    if obin_tree_newer(PathOps.join_path(toolchain, "packages"), stamp, 0) == 1:
        return 1
    if obin_tree_newer(PathOps.join_path(toolchain, "library"), stamp, 0) == 1:
        return 1
    return 0

fun obin_sources_newer(project: ObinProject, output: str, doletc: str) -> i32:
    if PathOps.exists(output) == 0:
        return 1
    stamp: i64 = obin_file_stamp(output)
    if obin_file_stamp(project.manifest) > stamp or obin_file_stamp(doletc) > stamp:
        return 1
    lock_path: str = PathOps.join_path(project.root, "dopm.lock")
    dependency_state: str = obin_resolve_from(PathOps.join_path(project.root, ".obin"), "dependencies.state")
    if obin_file_stamp(lock_path) > stamp or obin_file_stamp(dependency_state) > stamp:
        return 1
    if obin_project_sources_newer(project, stamp) == 1:
        return 1
    if obin_dependency_sources_newer(project, doletc, stamp) == 1:
        return 1
    return 0

fun obin_build_one(options: ObinOptions) -> i32:
    project: ObinProject = obin_require_project(options.manifest)
    document: ObinToml = obin_project_document(project)
    profile: str = options.profile
    if Memory.strlen(profile) == 0:
        profile = project.default_profile
    entry: str = obin_project_entry(project)
    configured_compiler: str = options.compiler
    if Memory.strlen(configured_compiler) == 0:
        configured_compiler = project.doletc
    if Memory.strlen(configured_compiler) > 0:
        project_compiler: str = obin_resolve_from(project.root, configured_compiler)
        if PathOps.exists(project_compiler) == 1:
            configured_compiler = project_compiler
    doletc: str = obin_find_doletc(configured_compiler)
    if Memory.strlen(doletc) == 0:
        print("obin: doletc was not found; set tools.doletc, OBIN_DOLETC, or PATH")
        return 1
    target_selector: str = options.target
    if Memory.strlen(target_selector) == 0:
        target_selector = project.target
    target: ObinTarget = obin_target_from(document, target_selector)
    if target.valid == 0:
        print(@"obin: {target.error}")
        return 1
    output: str = obin_project_output(project, document, target, profile, options.output)
    # Preserve target identity even when the incremental path returns early;
    # run/package consume this state after obin_build completes.
    g_obin_last_output = output
    g_obin_last_target_alias = target.alias
    g_obin_last_target_os = target.os
    if options.no_dependencies == 0:
        if obin_sync_dependencies(project, document, options.force) != 0:
            return 1
    if options.no_tools == 0:
        if obin_run_hooks(project, document, "before-build", options.verbose) != 0:
            return 1
    # A before-build hook is allowed to generate the configured entry file.
    # Validate it only after that hook has completed; checking it earlier makes
    # generated-entry projects impossible to build from a clean checkout.
    if PathOps.exists(entry) == 0:
        print(@"obin: entry file not found after before-build hooks: {entry}")
        return 1
    if options.no_tools == 0:
        if obin_frog_cook(project, document, doletc, options.force) != 0:
            return 1
    if project.incremental == 1:
        if options.force == 0:
            if obin_sources_newer(project, output, doletc) == 0:
                print(@"[obin] up to date: {output}")
                return 0
    if obin_ensure_directory(PathOps.get_directory(output)) == 0:
        print(@"obin: could not create output directory for {output}")
        return 1
    optimization: i32 = obin_profile_optimization(document, profile)
    optimization_flag: str = Str.concat(" -O", Convert.i32_to_str(optimization))
    command: str = Str.concat(obin_quote(doletc), Str.concat(" ", Str.concat(obin_quote(entry), Str.concat(" -o ", Str.concat(obin_quote(output), optimization_flag)))))
    command = Str.concat(command, Str.concat(" --target ", obin_quote(target.id)))
    package_root: str = obin_resolve_from(PathOps.join_path(project.root, ".dopm"), "packages")
    command = Str.concat(command, Str.concat(" --package-path ", obin_quote(package_root)))
    if obin_profile_no_console(document, project, profile) == 1:
        command = Str.concat(command, " --no-console")
    print(@"[obin] building {project.name} ({profile}, {target.alias} -> {target.id})")
    if options.verbose == 1:
        print(@"       {command}")
    code: i32 = obin_run_in_directory(command, project.root)
    if code != 0:
        print(@"obin: build failed with exit code {code}")
        return code
    if options.no_tools == 0:
        if obin_run_hooks(project, document, "after-build", options.verbose) != 0:
            return 1
    print(@"[obin] built {output}")
    return 0

fun obin_build(options: ObinOptions) -> i32:
    return obin_build_one(options)

fun obin_run(options: ObinOptions) -> i32:
    code: i32 = obin_build(options)
    if code != 0:
        return code
    host: str = Str.to_lower(PlatformInfo.name())
    if Str.equals(host, g_obin_last_target_os) == false:
        print(@"obin: cannot run a {g_obin_last_target_os} artifact on the {host} host")
        print("      the artifact was built successfully; run it on its target system")
        return 1
    command: str = Str.concat(obin_quote(g_obin_last_output), options.app_arguments)
    print(@"[obin] running {g_obin_last_output}")
    project: ObinProject = obin_require_project(options.manifest)
    return obin_run_in_directory(command, project.root)

fun obin_copy_packaged_assets_tree(source: str, destination: str, strip_cooked_sources: i32) -> i32:
    if PathOps.exists(source) == 0:
        return 0
    if obin_is_directory(source) == 0:
        if strip_cooked_sources == 1:
            lower: str = Str.to_lower(source)
            if Str.ends_with(lower, ".png"):
                cooked: str = obin_frog_texture_output(source)
                if obin_frog_texture_header_valid(cooked) == 1:
                    return 1
        directory: str = PathOps.get_directory(destination)
        if obin_ensure_directory(directory) == 0:
            return 0
        return PlatformHost.copy_file(source, destination)
    if obin_is_reparse_point(source) == 1:
        return 0
    if obin_ensure_directory(destination) == 0:
        return 0
    names: list<str> = Dir.list(source)
    index: i64 = 0
    while index < names.size():
        source_child: str = PathOps.join_path(source, names.get_str(index))
        destination_child: str = PathOps.join_path(destination, names.get_str(index))
        if obin_copy_packaged_assets_tree(source_child, destination_child, strip_cooked_sources) == 0:
            return 0
        index = index + 1
    return 1

fun obin_copy_assets(project: ObinProject, document: ObinToml, stage: str) -> i32:
    roots: list<str> = obin_toml_array(document, "assets.roots")
    if roots.size() == 0:
        default_assets: str = obin_resolve_from(project.root, "assets")
        if obin_is_directory(default_assets) == 1:
            roots.append("assets")
    if roots.size() == 0:
        return 0
    destination_root: str = PathOps.join_path(stage, project.asset_destination)
    destination_root = PathOps.resolve_path(destination_root)
    if obin_path_is_inside(destination_root, stage) == 0:
        print("obin: assets.destination must resolve inside the package stage")
        return 1
    strip_cooked_sources: i32 = 0
    if project.frog_enabled == 1 and project.frog_cook_textures == 1 and project.frog_keep_source_textures == 0:
        strip_cooked_sources = 1
    index: i64 = 0
    while index < roots.size():
        configured: str = roots.get_str(index)
        source: str = obin_resolve_from(project.root, configured)
        if PathOps.exists(source) == 0:
            print(@"obin: asset root not found: {source}")
            return 1
        if obin_path_is_inside(stage, source) == 1:
            print(@"obin: asset root cannot contain the package stage: {source}")
            return 1
        destination: str = destination_root
        if roots.size() > 1:
            destination = PathOps.join_path(destination_root, PathOps.get_filename(source))
        if obin_copy_packaged_assets_tree(source, destination, strip_cooked_sources) == 0:
            print(@"obin: failed to copy assets from {source}")
            return 1
        index = index + 1
    return 0

fun obin_copy_package_tree(source: str, destination: str) -> i32:
    if PathOps.exists(source) == 0:
        return 0
    # Package output must be self-contained. Host-local symlinks and Windows
    # reparse points can refer outside the project and become broken artifacts
    # on the target machine, so reject them instead of silently staging an
    # incomplete distributable. A thin SDK should include only its manifests
    # and a setup script which creates target-native links after installation.
    if obin_is_reparse_point(source) == 1:
        return 0
    if obin_is_directory(source) == 0:
        directory: str = PathOps.get_directory(destination)
        if obin_ensure_directory(directory) == 0:
            return 0
        return PlatformHost.copy_file(source, destination)
    if obin_ensure_directory(destination) == 0:
        return 0
    names: list<str> = Dir.list(source)
    index: i64 = 0
    while index < names.size():
        name: str = names.get_str(index)
        source_child: str = PathOps.join_path(source, name)
        if obin_is_directory(source_child) == 0 or obin_skip_directory(name) == 0:
            destination_child: str = PathOps.join_path(destination, name)
            if obin_copy_package_tree(source_child, destination_child) == 0:
                return 0
        index = index + 1
    return 1

fun obin_copy_package_include_list(project: ObinProject, includes: list<str>, stage: str) -> i32:
    index: i64 = 0
    while index < includes.size():
        configured: str = includes.get_str(index)
        if Memory.strlen(configured) == 0 or PathOps.is_absolute(configured):
            print(@"obin: package include must be a non-empty project-relative path: {configured}")
            return 1
        source: str = obin_resolve_from(project.root, configured)
        if obin_path_is_inside(source, project.root) == 0:
            print(@"obin: package include escapes the project root: {configured}")
            return 1
        if PathOps.exists(source) == 0:
            print(@"obin: package include not found: {source}")
            return 1
        destination: str = PathOps.resolve_path(PathOps.join_path(stage, configured))
        if obin_path_is_inside(destination, stage) == 0:
            print(@"obin: package include escapes the package stage: {configured}")
            return 1
        if obin_copy_package_tree(source, destination) == 0:
            print(@"obin: failed to package {source}")
            return 1
        index = index + 1
    return 0

fun obin_copy_package_includes(project: ObinProject, document: ObinToml, stage: str, target_alias: str) -> i32:
    common: list<str> = obin_toml_array(document, "package.include")
    if obin_copy_package_include_list(project, common, stage) != 0:
        return 1
    target_key: str = Str.concat("targets.", Str.concat(target_alias, ".package-include"))
    target_specific: list<str> = obin_toml_array(document, target_key)
    return obin_copy_package_include_list(project, target_specific, stage)

fun obin_validate_package_required_list(required: list<str>, stage: str) -> i32:
    index: i64 = 0
    while index < required.size():
        configured: str = required.get_str(index)
        if Memory.strlen(configured) == 0 or PathOps.is_absolute(configured):
            print(@"obin: package required path must be non-empty and relative: {configured}")
            return 1
        packaged: str = PathOps.resolve_path(PathOps.join_path(stage, configured))
        if obin_path_is_inside(packaged, stage) == 0:
            print(@"obin: package required path escapes the package stage: {configured}")
            return 1
        if PathOps.exists(packaged) == 0:
            print(@"obin: incomplete package; required path is missing: {configured}")
            return 1
        index = index + 1
    return 0

fun obin_validate_package_required(document: ObinToml, stage: str, target_alias: str) -> i32:
    common: list<str> = obin_toml_array(document, "package.require")
    if obin_validate_package_required_list(common, stage) != 0:
        return 1
    target_key: str = Str.concat("targets.", Str.concat(target_alias, ".package-require"))
    target_specific: list<str> = obin_toml_array(document, target_key)
    return obin_validate_package_required_list(target_specific, stage)

fun obin_package_one(options: ObinOptions) -> i32:
    project: ObinProject = obin_require_project(options.manifest)
    if Memory.strlen(options.profile) == 0:
        options.profile = "release"
    code: i32 = obin_build(options)
    if code != 0:
        return code
    document: ObinToml = obin_project_document(project)
    package_root: str = obin_resolve_from(project.root, project.package_directory)
    stage_name: str = Str.concat(project.name, Str.concat("-", Str.concat(project.version, Str.concat("-", g_obin_last_target_alias))))
    stage: str = PathOps.join_path(package_root, stage_name)
    if obin_path_is_inside(stage, project.root) == 0:
        print("obin: package.directory must resolve inside the project")
        return 1
    if PathOps.exists(stage) == 1:
        if obin_remove_tree(stage) == 0:
            print(@"obin: could not replace package directory {stage}")
            return 1
    if obin_ensure_directory(stage) == 0:
        return 1
    executable_root: str = stage
    if Memory.strlen(project.package_executable_directory) > 0:
        executable_root = obin_resolve_from(stage, project.package_executable_directory)
        if obin_path_is_inside(executable_root, stage) == 0:
            print("obin: package.executable-directory must resolve inside the package stage")
            return 1
        if obin_ensure_directory(executable_root) == 0:
            return 1
    packaged_executable: str = PathOps.join_path(executable_root, PathOps.get_filename(g_obin_last_output))
    if obin_copy_tree(g_obin_last_output, packaged_executable) == 0:
        print("obin: failed to stage executable")
        return 1
    if project.include_assets == 1:
        if obin_copy_assets(project, document, stage) != 0:
            return 1
    if obin_copy_package_includes(project, document, stage, g_obin_last_target_alias) != 0:
        return 1
    if options.no_tools == 0:
        if obin_run_hooks(project, document, "after-package", options.verbose) != 0:
            return 1
    # Hooks may add signed files or target-native runtime pieces. Validate the
    # final layout only after they finish so "package ready" is a real contract.
    if obin_validate_package_required(document, stage, g_obin_last_target_alias) != 0:
        return 1
    print(@"[obin] package ready: {stage}")
    return 0

fun obin_package(options: ObinOptions) -> i32:
    return obin_package_one(options)

fun obin_clean(manifest: str) -> i32:
    project: ObinProject = obin_require_project(manifest)
    targets: list<str> = []
    targets.append(obin_resolve_from(project.root, "build"))
    targets.append(obin_resolve_from(project.root, project.package_directory))
    targets.append(obin_resolve_from(PathOps.join_path(project.root, ".obin"), "dependencies.state"))
    index: i64 = 0
    while index < targets.size():
        target: str = targets.get_str(index)
        if PathOps.exists(target) == 1:
            if obin_path_is_inside(target, project.root) == 0:
                print(@"obin: refused or failed to remove {target}")
                return 1
            if obin_remove_tree(target) == 0:
                print(@"obin: refused or failed to remove {target}")
                return 1
        index = index + 1
    print("[obin] clean complete (cached tools were preserved)")
    return 0

fun obin_doctor(manifest: str) -> i32:
    project: ObinProject = obin_load_project(manifest)
    obin_executable: str = PathOps.get_exe_path()
    host_platform: str = PlatformInfo.name()
    print("Obin doctor")
    print(@"  executable : {obin_executable}")
    print(@"  platform   : {host_platform}")
    if project.valid == 0:
        print(@"  manifest   : unavailable ({project.error})")
        project = ObinProject()
    else:
        print(@"  manifest   : {project.manifest}")
        print(@"  project    : {project.name} {project.version}")
        document: ObinToml = obin_project_document(project)
        selected: ObinTarget = obin_target_from(document, project.target)
        if selected.valid == 1:
            print(@"  target     : {selected.alias} -> {selected.id}")
        else:
            print(@"  target     : INVALID ({selected.error})")
    configured_doletc: str = project.doletc
    configured_dopm: str = project.dopm
    if project.valid == 1 and Memory.strlen(configured_doletc) > 0:
        local_doletc: str = obin_resolve_from(project.root, configured_doletc)
        if PathOps.exists(local_doletc) == 1:
            configured_doletc = local_doletc
    if project.valid == 1 and Memory.strlen(configured_dopm) > 0:
        local_dopm: str = obin_resolve_from(project.root, configured_dopm)
        if PathOps.exists(local_dopm) == 1:
            configured_dopm = local_dopm
    doletc: str = obin_find_doletc(configured_doletc)
    dopm: str = obin_find_dopm(configured_dopm)
    if Memory.strlen(doletc) == 0:
        print("  doletc     : NOT FOUND")
    else:
        print(@"  doletc     : {doletc}")
    if Memory.strlen(dopm) == 0:
        print("  dopm       : not installed (only required for dependencies)")
    else:
        print(@"  dopm       : {dopm}")
    if project.valid == 1 and project.frog_enabled == 1:
        source: str = obin_frog_find_cooker_source(doletc)
        if Memory.strlen(source) == 0:
            print("  frog       : cooker source NOT FOUND")
            return 1
        print(@"  frog       : {source}")
    if Memory.strlen(doletc) == 0:
        return 1
    return 0

fun obin_init(directory: str):
    root: str = directory
    if Memory.strlen(root) == 0:
        root = PathOps.get_cwd()
    root = PathOps.resolve_path(root)
    if obin_ensure_directory(root) == 0:
        obin_fail(@"could not create {root}")
    manifest: str = PathOps.join_path(root, "obin.toml")
    if PathOps.exists(manifest) == 1:
        obin_fail(@"manifest already exists: {manifest}")
    name: str = PathOps.get_filename(root)
    if Memory.strlen(name) == 0 or obin_toml_valid_key(name) == 0 or Str.contains(name, "."):
        name = "my-app"
    content: str = Str.concat("[application]\nname = \"", name)
    content = Str.concat(content, "\"\nversion = \"0.1.0\"\nentry = \"src/main.dlt\"\ntype = \"console\"\n\n")
    content = Str.concat(content, "[build]\ndefault-target = \"windows\"\ndefault-profile = \"dev\"\nincremental = true\n\n")
    content = Str.concat(content, "[targets.windows]\nid = \"windows/x86_64\"\n\n[targets.linux]\nid = \"linux/x86_64\"\n\n")
    content = Str.concat(content, "[profiles.dev]\noptimization = 0\nno-console = false\n\n[profiles.release]\noptimization = 3\nno-console = false\n\n")
    content = Str.concat(content, "[packages]\nauto-sync = true\n\n[assets]\nroots = [\"assets\"]\ndestination = \"assets\"\n\n")
    content = Str.concat(content, "[package]\ndirectory = \"dist\"\ninclude-assets = true\n")
    if obin_write_text(manifest, content) == 0:
        obin_fail("could not write obin.toml")
    entry: str = PathOps.join_path(PathOps.join_path(root, "src"), "main.dlt")
    if PathOps.exists(entry) == 0:
        if obin_write_text(entry, "print(\"Hello from Dolet!\")\n") == 0:
            obin_fail("could not write src/main.dlt")
    assets: str = PathOps.join_path(root, "assets")
    if obin_ensure_directory(assets) == 0:
        obin_fail("could not create assets directory")
    print(@"[obin] initialized {name} at {root}")
